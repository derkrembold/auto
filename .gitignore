# SSH-Keys und sensible Zugangsdaten niemals versionieren
.ssh/
id_*
*.pem
*.key
known_hosts*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Betriebssystem-Müll
.DS_Store
Thumbs.db
desktop.ini

# Editor-Backup-/Swap-Dateien
*~

# Saleae Rohdaten (können groß werden - je nach Bedarf anpassen)
saleae/exports/*.sal

# Datenblätter - groß, öffentlich verfügbar, leicht neu herunterladbar
STM32/datasheets/*.pdf

# Obsidian UI-Zustand - lokal, kein Projektinhalt
.obsidian/

# STM32 Build-Artefakte - regenerierbar via STM32/build.sh, sonst riesige Diffs
STM32/firmware/Debug/**/*.o
STM32/firmware/Debug/**/*.d
STM32/firmware/Debug/**/*.su
STM32/firmware/Debug/**/*.cyclo
STM32/firmware/Debug/*.elf
STM32/firmware/Debug/*.list
STM32/firmware/Debug/*.map
STM32/firmware/Debug/default.size.stdout
