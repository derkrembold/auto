# SSH-Keys und sensible Zugangsdaten niemals versionieren
.ssh/
id_*
*.pem
*.key
known_hosts*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Betriebssystem-Müll
.DS_Store
Thumbs.db
desktop.ini

# Editor-Backup-/Swap-Dateien
*~

# Manuelle Backup-Kopien vor riskanten Änderungen (z.B. main.cbak)
*.cbak

# Saleae Rohdaten (können groß werden - je nach Bedarf anpassen)
saleae/exports/*.sal

# Datenblätter - groß, öffentlich verfügbar, leicht neu herunterladbar
STM32/datasheets/*.pdf

# Obsidian UI-Zustand - lokal, kein Projektinhalt
.obsidian/

# STM32 Build-Artefakte - regenerierbar via STM32/build.sh, sonst riesige Diffs
STM32/firmware/Debug/**/*.o
STM32/firmware/Debug/**/*.d
STM32/firmware/Debug/**/*.su
STM32/firmware/Debug/**/*.cyclo
STM32/firmware/Debug/*.elf
STM32/firmware/Debug/*.list
STM32/firmware/Debug/*.map
STM32/firmware/Debug/default.size.stdout
STM32/build.log
STM32/flash.log
raspi/deploy.log

# Runtime logs (watchdog.py, motorcontrol.py, validate_speed.py,
# capture_step_response.py -- see logsetup.py) - rotated (one generation
# kept as *.log.1), regenerated every run, not repo content.
raspi/control/*.log
raspi/control/*.log.1
raspi/watchdog/*.log
raspi/watchdog/*.log.1

# AVR Build-Artefakte (currentsensor/lightsensor) - regenerierbar via
# make (siehe jeweiliges CLAUDE.md), sonst riesige Diffs
currentsensor/firmware/*.o
currentsensor/firmware/*.i
currentsensor/firmware/*.ii
currentsensor/firmware/*.s
currentsensor/*.elf
currentsensor/*.hex
lightsensor/firmware/*.o
lightsensor/firmware/*.i
lightsensor/firmware/*.ii
lightsensor/firmware/*.s
lightsensor/*.elf
lightsensor/*.hex
